# Copy this file to `.env.local` and fill in real values.
# Exception: DATABASE_URL must ALSO exist in a plain `.env` file (not just
# `.env.local`) because drizzle-kit's CLI only loads `.env` (see drizzle.config.ts).

# --- Backend connection ---
# Base URL of the ai-engine FastAPI service. Points the frontend at your
# local backend during development; set to the deployed backend URL in
# production (e.g. your Render service URL).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (Neon Postgres) ---
# Required in `.env` for drizzle-kit, and in `.env.local` for the app itself.
DATABASE_URL=

# --- Clerk authentication (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Vapi voice AI (https://dashboard.vapi.ai) ---
# Powers the live voice-call tab in the MediForge receptionist widget.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
